rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ebny_bitak/houses/{sellerId}/{houseId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == sellerId
        && fileName.matches('^[0-4]\\.(jpg|png|webp|gif)$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == sellerId;
    }
  }
}
